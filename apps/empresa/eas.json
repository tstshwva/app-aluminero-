{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "demo": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_DEMO": "1"
      }
    },
    "ios-production": {
      "channel": "empresa-production",
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_DEMO": "0"
      },
      "environment": "production"
    },
    "ios-simulator": {
      "ios": {
        "simulator": true
      },
      "channel": "empresa-production",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_DEMO": "0"
      },
      "environment": "production"
    }
  }
}
