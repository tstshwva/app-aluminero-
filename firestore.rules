rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function staff() {
      return signedIn() &&
        get(/databases/$(database)/documents/aluf_staff/$(request.auth.uid)).data.active == true;
    }

    function invitePath(code) {
      return /databases/$(database)/documents/aluf_invites/$(code);
    }

    match /aluf_staff/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['active', 'role', 'inviteCode']) &&
        request.resource.data.active == true &&
        request.resource.data.role == "Operador" &&
        request.resource.data.inviteCode.matches('^[a-f0-9]{32}

    match /categorias/{categoryId} {
      allow get, list: if signedIn();
    }

    match /catalogo/{productoId} {
      allow get, list: if signedIn();
    }

    match /usuarios/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
    }

    match /pedidos/{pedidoId} {
      allow get: if signedIn() && resource == null;
      allow get, list: if signedIn() &&
        (resource.data.ownerUid == request.auth.uid || staff());

      allow create: if signedIn() &&
        pedidoId.matches('^[0-9a-fA-F-]{36}$') &&
        request.resource.data.keys().hasAll(
          ['ownerUid', 'status', 'fulfillment', 'deliveryAddress', 'notes', 'items', 'createdAt']
        ) &&
        request.resource.data.keys().hasOnly(
          ['ownerUid', 'status', 'fulfillment', 'deliveryAddress', 'notes', 'items', 'createdAt']
        ) &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.status == 'Solicitado' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.notes is string &&
        request.resource.data.notes.size() <= 2000 &&
        request.resource.data.deliveryAddress is string &&
        request.resource.data.deliveryAddress.size() <= 500 &&
        ((request.resource.data.fulfillment == 'Recoger' &&
          request.resource.data.deliveryAddress == '') ||
         (request.resource.data.fulfillment == 'Entrega' &&
          request.resource.data.deliveryAddress.size() > 0)) &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.items.size() <= 50;
    }
  }
}
) &&
        get(invitePath(request.resource.data.inviteCode)).data.usedBy == null &&
        getAfter(invitePath(request.resource.data.inviteCode)).data.usedBy == uid;
    }

    match /aluf_invites/{code} {
      allow update: if signedIn() &&
        resource.data.email == request.auth.token.email &&
        resource.data.usedBy == null &&
        resource.data.expiresAt > request.time &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy']) &&
        request.resource.data.usedBy == request.auth.uid &&
        getAfter(/databases/$(database)/documents/aluf_staff/$(request.auth.uid)).data.inviteCode == code;
    }

    match /categorias/{categoryId} {
      allow get, list: if signedIn();
    }

    match /catalogo/{productoId} {
      allow get, list: if signedIn();
    }

    match /usuarios/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
    }

    match /pedidos/{pedidoId} {
      allow get: if signedIn() && resource == null;
      allow get, list: if signedIn() &&
        (resource.data.ownerUid == request.auth.uid || staff());

      allow create: if signedIn() &&
        pedidoId.matches('^[0-9a-fA-F-]{36}$') &&
        request.resource.data.keys().hasAll(
          ['ownerUid', 'status', 'fulfillment', 'deliveryAddress', 'notes', 'items', 'createdAt']
        ) &&
        request.resource.data.keys().hasOnly(
          ['ownerUid', 'status', 'fulfillment', 'deliveryAddress', 'notes', 'items', 'createdAt']
        ) &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.status == 'Solicitado' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.notes is string &&
        request.resource.data.notes.size() <= 2000 &&
        request.resource.data.deliveryAddress is string &&
        request.resource.data.deliveryAddress.size() <= 500 &&
        ((request.resource.data.fulfillment == 'Recoger' &&
          request.resource.data.deliveryAddress == '') ||
         (request.resource.data.fulfillment == 'Entrega' &&
          request.resource.data.deliveryAddress.size() > 0)) &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.items.size() <= 50;
    }
  }
}
